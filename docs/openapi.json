          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Slot"
                  }
                }
              }
            },
            "description" : "Free slots, earliest first"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Period reversed or longer than 31 days (type /problems/invalid-period)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unknown doctor (type /problems/doctor-not-found)"
          }
        },
        "summary" : "List the free slots of a doctor",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/first-free-slots" : {
      "get" : {
        "description" : "Looks from now up to 90 days ahead, among all the doctors of each specialty. A specialty with no free slot in that period is left out.",
