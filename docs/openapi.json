{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Appointment booking for a fictional outpatient clinic. Errors are returned as RFC 9457 Problem Details.",
    "title" : "Agenda Ambulatorio API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Specialties and doctors a patient can choose from",
    "name" : "Catalogue"
  }, {
    "description" : "What a patient can do without an account",
    "name" : "Booking"
  } ],
  "paths" : {
    "/api/v1/bookings" : {
      "post" : {
        "operationId" : "book",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "Booked"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid input (type /problems/validation, with the list of fields)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The slot is not offered or was just taken (type /problems/slot-not-available)"
          }
        },
        "summary" : "Book a slot",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/cancellation" : {
      "post" : {
        "operationId" : "cancel",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "The cancelled booking"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Wrong code or wrong e-mail (type /problems/booking-not-found)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Already cancelled or already started (type /problems/appointment-state)"
          }
        },
        "summary" : "Cancel a booking, given its code and the e-mail used to book",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/lookup" : {
      "post" : {
        "operationId" : "find",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "The booking"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Wrong code or wrong e-mail (type /problems/booking-not-found)"
          }
        },
        "summary" : "Show a booking, given its code and the e-mail used to book",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/doctors" : {
      "get" : {
        "operationId" : "doctors",
        "parameters" : [ {
          "in" : "query",
          "name" : "specialtyId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DoctorSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the doctors of a specialty",
        "tags" : [ "Catalogue" ]
      }
    },
    "/api/v1/doctors/{doctorId}/slots" : {
      "get" : {
        "description" : "Both days are included and are meant in the clinic's time zone.",
        "operationId" : "freeSlots",
        "parameters" : [ {
          "in" : "path",
          "name" : "doctorId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Slot"
                  }
                }
              }
            },
            "description" : "Free slots, earliest first"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Period reversed or longer than 31 days (type /problems/invalid-period)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unknown doctor (type /problems/doctor-not-found)"
          }
        },
        "summary" : "List the free slots of a doctor",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/specialties" : {
      "get" : {
        "operationId" : "specialties",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SpecialtySummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the specialties, in alphabetical order",
        "tags" : [ "Catalogue" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "BookingDetails" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "doctorName" : {
            "type" : "string"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "patientName" : {
            "type" : "string"
          },
          "specialty" : {
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "BOOKED", "ARRIVED", "NO_SHOW", "CANCELLED" ]
          }
        },
        "required" : [ "code", "doctorName", "endsAt", "patientName", "specialty", "startsAt", "status" ]
      },
      "BookingRequest" : {
        "type" : "object",
        "properties" : {
          "doctorId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "patientEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "patientName" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "patientPhone" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\+?[0-9 ]{6,20}"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "doctorId", "patientEmail", "patientName", "patientPhone", "startsAt" ]
      },
      "DoctorSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "specialty" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "specialty" ]
      },
      "EmailRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "InvalidField" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 Problem Details. `type` tells the kinds of error apart.",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "description" : "Only for /problems/validation: the fields that were rejected",
            "items" : {
              "$ref" : "#/components/schemas/InvalidField"
            }
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "example" : "/problems/slot-not-available"
          }
        },
        "required" : [ "detail", "instance", "status", "title", "type" ]
      },
      "Slot" : {
        "type" : "object",
        "properties" : {
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "endsAt", "startsAt" ]
      },
      "SpecialtySummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      }
    }
  }
}
