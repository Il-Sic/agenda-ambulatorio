            "description" : "One slot per doctor"
          }
        },
        "summary" : "Give the first free slot of each doctor of a specialty",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/doctors/{doctorId}/slots" : {
      "get" : {
        "description" : "Both days are included and are meant in the clinic's time zone. Visits can be booked from today up to 90 days ahead.",
