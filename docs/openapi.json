{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Appointment booking for a fictional outpatient clinic. Errors are returned as RFC 9457 Problem Details.",
    "title" : "Agenda Ambulatorio API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "The day's visits and what happened to them",
    "name" : "Staff agenda"
  }, {
    "description" : "Weekly availability of doctors and closure days",
    "name" : "Staff schedule"
  }, {
    "description" : "Staff sign in by posting `username` and `password` as a form to /api/v1/auth/login and sign out by posting to /api/v1/auth/logout. Both answer 204.",
    "name" : "Authentication"
  }, {
    "description" : "Specialties and doctors a patient can choose from",
    "name" : "Catalogue"
  }, {
    "description" : "What a patient can do without an account",
    "name" : "Booking"
  } ],
  "paths" : {
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Who is signed in. Answers 401 when nobody is.",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/bookings" : {
      "post" : {
        "operationId" : "book",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "Booked"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid input (type /problems/validation, with the list of fields)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The slot is not offered or was just taken (type /problems/slot-not-available)"
          }
        },
        "summary" : "Book a slot",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/cancellation" : {
      "post" : {
        "operationId" : "cancel_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "The cancelled booking"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Wrong code or wrong e-mail (type /problems/booking-not-found)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Already cancelled or already started (type /problems/appointment-state)"
          }
        },
        "summary" : "Cancel a booking, given its code and the e-mail used to book",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/lookup" : {
      "post" : {
        "operationId" : "find",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "The booking"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Wrong code or wrong e-mail (type /problems/booking-not-found)"
          }
        },
        "summary" : "Show a booking, given its code and the e-mail used to book",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/doctors" : {
      "get" : {
        "operationId" : "doctors_1",
        "parameters" : [ {
          "in" : "query",
          "name" : "specialtyId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DoctorSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the doctors of a specialty",
        "tags" : [ "Catalogue" ]
      }
    },
    "/api/v1/doctors/{doctorId}/slots" : {
      "get" : {
        "description" : "Both days are included and are meant in the clinic's time zone.",
        "operationId" : "freeSlots",
        "parameters" : [ {
          "in" : "path",
          "name" : "doctorId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Slot"
                  }
                }
              }
            },
            "description" : "Free slots, earliest first"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Period reversed or longer than 31 days (type /problems/invalid-period)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unknown doctor (type /problems/doctor-not-found)"
          }
        },
        "summary" : "List the free slots of a doctor",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/specialties" : {
      "get" : {
        "operationId" : "specialties",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SpecialtySummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the specialties, in alphabetical order",
        "tags" : [ "Catalogue" ]
      }
    },
    "/api/v1/staff/agenda" : {
      "get" : {
        "operationId" : "day",
        "parameters" : [ {
          "in" : "query",
          "name" : "date",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "in" : "query",
          "name" : "doctorId",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AgendaEntry"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the appointments of a day, earliest first",
        "tags" : [ "Staff agenda" ]
      }
    },
    "/api/v1/staff/appointments/{id}/arrival" : {
      "post" : {
        "description" : "Answers 409 with type /problems/appointment-state when the change makes no sense for the appointment, or /problems/concurrent-update when someone else changed it first.",
        "operationId" : "markArrived",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgendaEntry"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Record that the patient has arrived",
        "tags" : [ "Staff agenda" ]
      }
    },
    "/api/v1/staff/appointments/{id}/cancellation" : {
      "post" : {
        "description" : "Answers 409 with type /problems/appointment-state when the change makes no sense for the appointment, or /problems/concurrent-update when someone else changed it first.",
        "operationId" : "cancel",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgendaEntry"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Cancel a visit that has not started yet",
        "tags" : [ "Staff agenda" ]
      }
    },
    "/api/v1/staff/appointments/{id}/no-show" : {
      "post" : {
        "description" : "Answers 409 with type /problems/appointment-state when the change makes no sense for the appointment, or /problems/concurrent-update when someone else changed it first.",
        "operationId" : "markNoShow",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgendaEntry"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Record that the patient did not show up",
        "tags" : [ "Staff agenda" ]
      }
    },
    "/api/v1/staff/availability/{availabilityId}" : {
      "delete" : {
        "operationId" : "removeAvailability",
        "parameters" : [ {
          "in" : "path",
          "name" : "availabilityId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Remove a weekly availability window (admin)",
        "tags" : [ "Staff schedule" ]
      }
    },
    "/api/v1/staff/closures" : {
      "get" : {
        "operationId" : "closures",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Closure"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List today's and future closure days",
        "tags" : [ "Staff schedule" ]
      },
      "post" : {
        "description" : "Answers 409 with type /problems/closure-exists if the day is already closed.",
        "operationId" : "close",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ClosureRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Closure"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Close the clinic on a day (admin)",
        "tags" : [ "Staff schedule" ]
      }
    },
    "/api/v1/staff/closures/{closureId}" : {
      "delete" : {
        "operationId" : "reopen",
        "parameters" : [ {
          "in" : "path",
          "name" : "closureId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Reopen a closed day (admin)",
        "tags" : [ "Staff schedule" ]
      }
    },
    "/api/v1/staff/doctors" : {
      "get" : {
        "operationId" : "doctors",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DoctorSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List every doctor",
        "tags" : [ "Staff schedule" ]
      }
    },
    "/api/v1/staff/doctors/{doctorId}/availability" : {
      "get" : {
        "operationId" : "availability",
        "parameters" : [ {
          "in" : "path",
          "name" : "doctorId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AvailabilityWindow"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List the weekly availability of a doctor",
        "tags" : [ "Staff schedule" ]
      },
      "post" : {
        "description" : "Answers 409 with type /problems/availability-overlap if it overlaps another.",
        "operationId" : "addAvailability",
        "parameters" : [ {
          "in" : "path",
          "name" : "doctorId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AvailabilityRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AvailabilityWindow"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Add a weekly availability window (admin)",
        "tags" : [ "Staff schedule" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AgendaEntry" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "doctorId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "doctorName" : {
            "type" : "string"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "patientEmail" : {
            "type" : "string"
          },
          "patientName" : {
            "type" : "string"
          },
          "patientPhone" : {
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "BOOKED", "ARRIVED", "NO_SHOW", "CANCELLED" ]
          }
        },
        "required" : [ "code", "doctorId", "doctorName", "endsAt", "id", "patientEmail", "patientName", "patientPhone", "startsAt", "status" ]
      },
      "AvailabilityRequest" : {
        "type" : "object",
        "properties" : {
          "dayOfWeek" : {
            "type" : "string",
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
          },
          "endTime" : {
            "type" : "string",
            "example" : "13:00"
          },
          "slotMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 240,
            "minimum" : 5
          },
          "startTime" : {
            "type" : "string",
            "example" : "09:00"
          }
        },
        "required" : [ "dayOfWeek", "endTime", "slotMinutes", "startTime" ]
      },
      "AvailabilityWindow" : {
        "type" : "object",
        "properties" : {
          "dayOfWeek" : {
            "type" : "string",
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
          },
          "endTime" : {
            "type" : "string",
            "example" : "13:00"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slotMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "startTime" : {
            "type" : "string",
            "example" : "09:00"
          }
        },
        "required" : [ "dayOfWeek", "endTime", "id", "slotMinutes", "startTime" ]
      },
      "BookingDetails" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "doctorName" : {
            "type" : "string"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "patientName" : {
            "type" : "string"
          },
          "specialty" : {
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "BOOKED", "ARRIVED", "NO_SHOW", "CANCELLED" ]
          }
        },
        "required" : [ "code", "doctorName", "endsAt", "patientName", "specialty", "startsAt", "status" ]
      },
      "BookingRequest" : {
        "type" : "object",
        "properties" : {
          "doctorId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "patientEmail" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "patientName" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "patientPhone" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\+?[0-9 ]{6,20}"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "doctorId", "patientEmail", "patientName", "patientPhone", "startsAt" ]
      },
      "Closure" : {
        "type" : "object",
        "properties" : {
          "day" : {
            "type" : "string",
            "format" : "date"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reason" : {
            "type" : "string"
          }
        },
        "required" : [ "day", "id", "reason" ]
      },
      "ClosureRequest" : {
        "type" : "object",
        "properties" : {
          "day" : {
            "type" : "string",
            "format" : "date"
          },
          "reason" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "day", "reason" ]
      },
      "CurrentUser" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "STAFF", "ADMIN" ]
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "role", "username" ]
      },
      "DoctorSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "specialty" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name", "specialty" ]
      },
      "EmailRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "InvalidField" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 Problem Details. `type` tells the kinds of error apart.",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "description" : "Only for /problems/validation: the fields that were rejected",
            "items" : {
              "$ref" : "#/components/schemas/InvalidField"
            }
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "example" : "/problems/slot-not-available"
