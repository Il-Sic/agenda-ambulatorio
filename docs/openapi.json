{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Appointment booking for a fictional outpatient clinic. Errors are returned as RFC 9457 Problem Details.",
    "title" : "Agenda Ambulatorio API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "The day's visits and what happened to them",
    "name" : "Staff agenda"
  }, {
    "description" : "Weekly availability of doctors and closure days",
    "name" : "Staff schedule"
  }, {
    "description" : "Staff sign in by posting `username` and `password` as a form to /api/v1/auth/login and sign out by posting to /api/v1/auth/logout. Both answer 204.",
    "name" : "Authentication"
  }, {
    "description" : "Specialties and doctors a patient can choose from",
    "name" : "Catalogue"
  }, {
    "description" : "What a patient can do without an account",
    "name" : "Booking"
  }, {
    "description" : "E-mails produced from booking events",
    "name" : "Notifications"
  } ],
  "paths" : {
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Who is signed in. Answers 401 when nobody is.",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/bookings" : {
      "post" : {
        "operationId" : "book",
        "parameters" : [ {
          "description" : "Any unique value chosen by the client. Sending the same request again with the same key returns the booking already made instead of a conflict.",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "Booked"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid input (type /problems/validation, with the list of fields)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The slot is not offered or was just taken (type /problems/slot-not-available), or the idempotency key was used for a different booking (type /problems/idempotency-key-reused)"
          }
        },
        "summary" : "Book a slot",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/cancellation" : {
      "post" : {
        "operationId" : "cancel_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetails"
                }
              }
            },
            "description" : "The cancelled booking"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Wrong code or wrong e-mail (type /problems/booking-not-found)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Already cancelled or already started (type /problems/appointment-state)"
          }
        },
        "summary" : "Cancel a booking, given its code and the e-mail used to book",
        "tags" : [ "Booking" ]
      }
    },
    "/api/v1/bookings/{code}/lookup" : {
      "post" : {
        "operationId" : "find",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
