# Optional overrides for compose.yaml. Copy to .env and edit.
# These values are examples for local use only: never reuse them anywhere else.

# Port where the application is published on your machine.
APP_PORT=8080

# Address it listens on. The default keeps the demo private to this computer.
# Use 0.0.0.0 to open it from a phone on the same network.
APP_BIND=127.0.0.1

POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda-local-only
